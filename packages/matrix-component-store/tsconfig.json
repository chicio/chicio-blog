{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src/**/*.ts", "tsdown.config.ts"]
}
