{
  "name": "matrix-rain-webgpu",
  "version": "2.0.0",
  "description": "WebGPU/TypeGPU Matrix-rain background effect for React.",
  "keywords": [
    "background-effect",
    "matrix-rain",
    "react",
    "shader",
    "typegpu",
    "webgpu"
  ],
  "homepage": "https://chicio.github.io/matrix-rain-webgpu/",
  "bugs": "https://github.com/chicio/chicio-blog/issues",
  "license": "MIT",
  "author": "Fabrizio Duroni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicio/chicio-blog.git",
    "directory": "packages/matrix-rain-webgpu"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "types": "tsc -b",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "lint": "oxlint --max-warnings 0 && oxfmt --check",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@typegpu/noise": "0.11.0",
    "@typegpu/react": "0.11.2",
    "typegpu": "0.11.9"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@webgpu/types": "^0.1.71",
    "eslint-plugin-typegpu": "^0.11.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.72.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "release-it": "^20.2.1",
    "typescript": "npm:tsover@^6.0.2",
    "unplugin-typegpu": "^0.11.6",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
