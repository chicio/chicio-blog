{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "stream",
    "globalDependencies": [
        ".prettierrc",
        ".nvmrc"
    ],
    "globalEnv": [
        "CI",
        "CONTACT_EMAIL",
        "GOOGLE_ANALYTICS_API_SECRET",
        "GOOGLE_ANALYTICS_PROPERTY_ID",
        "GOOGLE_ANALYTICS_SA_CLIENT_EMAIL",
        "GOOGLE_ANALYTICS_SA_PRIVATE_KEY",
        "GROQ_API_KEY",
        "NODE_ENV",
        "RESEND_API_KEY",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_VECTOR_REST_TOKEN",
        "UPSTASH_VECTOR_REST_URL"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^build"
            ]
        },
        "knip": {
            "dependsOn": [
                "^build"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ]
        },
        "validate-architecture": {},
        "test": {
            "cache": false,
            "persistent": true
        },
        "test:run": {
            "dependsOn": [
                "^build"
            ]
        },
        "test:coverage": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "coverage/**"
            ]
        },
        "test:e2e": {
            "dependsOn": [
                "build"
            ],
            "outputs": [
                "playwright-report/**"
            ]
        }
    }
}
