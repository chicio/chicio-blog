# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
playwright-report/
test-results/

# next.js
.next/
out/

# turborepo
.turbo/

# production
/build

# misc
.DS_Store
*.pem
.search-index-cache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# JetBrains IDEs. This project is developed in VS Code; the whole directory is ignored
# rather than the ~77 lines of the upstream JetBrains template it replaces.
.idea/

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/mcp.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Git worktrees
agent/
.worktrees/
.claude/worktrees

# CodeGraph local index and daemon state (machine-local, regenerated by codegraph)
.codegraph/
# design-sync (claude.ai/design) — staged scripts + generated build output. Both .ds-sync/ and
# .design-sync/ live in packages/matrix-design-system/ and must stay siblings: the fork in
# .design-sync/overrides/ imports ../.ds-sync/lib/. The durable inputs (config.json, NOTES.md,
# conventions.md, fonts/, overrides/) ARE committed.
#
# The patterns below need **/ — a pattern with a middle slash is anchored to this file's directory,
# so a bare `.design-sync/.cache/` silently stops matching once the folder is not at the repo root.
.ds-sync/
# The storybook build design-sync compares against — regenerated, minutes to build.
**/.design-sync/sb-reference/
ds-bundle/
**/.design-sync/.cache/
**/.design-sync/learnings/
**/.design-sync/node_modules

# design-sync: generated .d.ts tree consumed by the converter (cfg.buildCmd regenerates it)
dist/
